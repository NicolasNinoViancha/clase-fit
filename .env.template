# Template of every variable the app reads. This is the ONLY env file under
# version control (see .gitignore): the values below are placeholders.
#
# Setup: copy this file to `.env` and fill in the real values.
#
# Where each value belongs:
#   .env        the app's variables. Gitignored.
#   .env.local  overrides `.env` for this machine only. Gitignored.
#   EAS         a cloud build receives NO .env file, since nothing gitignored is
#               uploaded to the build job. Variables a build needs must exist as
#               EAS environment variables (`eas env:set`), referenced by
#               `environment` in eas.json and pulled with `eas env:pull`.
#
# Only the EXPO_PUBLIC_ prefix is exposed to the app, and those values ship in
# plain text inside the bundle — never put secrets here.

# Base url every httpClient request is prefixed with. No trailing slash: every
# endpoint already starts with one (for example "/users").
EXPO_PUBLIC_API_URL=https://www.endpointExample.com

# "true" swaps core/httpClient for the simulated transport (fake/http.client.fake.ts).
EXPO_PUBLIC_IS_DEV_MODE=false
